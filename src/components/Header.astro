---
import Arrow from './Arrow.astro';
import { site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [
  { href: '/our-story/', label: 'Our Story' },
  { href: '/sister-support/', label: 'Sister Support' },
  { href: '/events/', label: 'Events' },
];
const isCurrent = (href: string) => path === href.replace(/\/$/, '');
---
<header class="site-header on-dark">
  <a class="skip" href="#main">Skip to content</a>
  <div class="bar">
    <a class="brand" href="/" aria-label="Toteally Sisters, home">
      <img src="/images/toteallySistersLogo.svg" width="240" height="109" alt="" />
    </a>

    <nav class="desktop" aria-label="Main">
      <ul>
        {items.map((i) => <li><a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a></li>)}
        <li><a href={site.ocraHome} rel="noopener">Donate</a></li>
      </ul>
      <a class="btn get-involved" href="/get-involved/" aria-current={isCurrent('/get-involved/') ? 'page' : undefined}>Get Involved <Arrow dir="out" /></a>
    </nav>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="l1" d="M4 7h16"/><path class="l2" d="M4 12h16"/><path class="l3" d="M4 17h16"/></svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Main">
      <a class="btn" href="/get-involved/">Get Involved</a>
      <ul>
        <li><a href="/">Home</a></li>
        {items.map((i) => <li><a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a></li>)}
        <li><a href={site.ocraHome} rel="noopener">Donate</a></li>
      </ul>
      <ul class="social">
        <li><a href={site.facebook} rel="noopener" aria-label="Facebook"><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/></svg></a></li>
        <li><a href={site.instagram} rel="noopener" aria-label="Instagram"><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { set(false); toggle.focus(); }
    });
    matchMedia('(min-width: 1025px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>

<style>
  .site-header { background: #000; color: #fff; position: relative; z-index: 50; }
  .skip { position: absolute; left: 1rem; top: -100px; z-index: 60; background: var(--peach); color: #000; padding: 0.7rem 1rem; border-radius: 8px; font-weight: 700; }
  .skip:focus { top: 0.75rem; }
  .bar { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; padding: 0 60px; max-width: 1440px; margin-inline: auto; }
  .brand img { width: 240px; height: auto; }
  .desktop { display: flex; align-items: center; gap: 41px; }
  .desktop ul { list-style: none; padding: 0; display: flex; gap: 35px; }
  .desktop ul a {
    font-size: 14px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; text-decoration: none;
    background: linear-gradient(var(--peach), var(--peach)) left calc(100% + 6px) / 0 2px no-repeat;
    padding-bottom: 6px; transition: background-size 220ms var(--ease), color 220ms var(--ease);
  }
  .desktop ul a:hover { background-size: 100% 2px; }
  .desktop ul a[aria-current='page'] { color: var(--peach); }
  .get-involved { font-size: 14px; padding: 16px 30px; }
  .get-involved[aria-current='page'] { background: #fff; color: var(--purple); border-color: #fff; }
  .menu-toggle { display: none; background: none; border: 0; color: #fff; width: 48px; height: 48px; align-items: center; justify-content: center; }
  .menu-toggle path { transition: transform 220ms var(--ease), opacity 220ms var(--ease); transform-box: fill-box; transform-origin: center; }
  .menu-toggle[aria-expanded='true'] .l1 { transform: translateY(5px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .l2 { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .l3 { transform: translateY(-5px) rotate(-45deg); }

  .mobile-menu { position: fixed; inset: var(--header-h) 0 0 0; background: #000; overflow-y: auto; padding: 1.5rem 20px 3rem; z-index: 49; }
  .mobile-menu nav { display: flex; flex-direction: column; gap: 1.75rem; max-width: 30rem; }
  .mobile-menu .btn { width: 100%; font-size: 14px; }
  .mobile-menu ul { list-style: none; padding: 0; }
  .mobile-menu ul:not(.social) a { display: block; padding: 0.85rem 0; border-bottom: 1px solid rgb(255 255 255 / 0.14); font-family: var(--serif); font-size: 2rem; line-height: 1.1; text-decoration: none; }
  .mobile-menu a[aria-current='page'] { color: var(--peach); }
  .social { display: flex; gap: 0.75rem; }
  .social a { display: inline-flex; width: 48px; height: 48px; align-items: center; justify-content: center; border-radius: 10px; background: #262626; }
  .social li:first-child a { background: #3b5998; }

  @media (max-width: 1024px) {
    .site-header { position: sticky; top: 0; }
    .bar { padding: 0 20px; }
    .desktop { display: none; }
    .menu-toggle { display: inline-flex; }
  }
  @media (max-width: 767px) { .brand img { width: 160px; } }
  :global(html.menu-open) { overflow: hidden; }
</style>

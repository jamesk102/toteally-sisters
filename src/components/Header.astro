---
import logo from '../assets/brand/logo.svg';
import { nav, site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header on-dark">
  <a class="skip" href="#main">Skip to content</a>
  <div class="bar">
    <a class="brand" href="/" aria-label="Toteally Sisters, home">
      <img src={logo.src} width="176" height="80" alt="" />
    </a>

    <nav class="desktop" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a class="donate" href={site.ocraDonate} rel="noopener">Donate via OCRA<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens OCRA's site)</span></a></li>
      </ul>
      <a class="btn join" href="/join" aria-current={isCurrent('/join') ? 'page' : undefined}>Join a meetup</a>
    </nav>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="l1" d="M4 7h16"/><path class="l2" d="M4 12h16"/><path class="l3" d="M4 17h16"/></svg>
      <span class="label">Menu</span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Main">
      <a class="btn" href="/join">Join a meetup</a>
      <ul>
        <li><a href="/">Home</a></li>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a href="/in-the-news">In the News</a></li>
      </ul>
      <a class="donate" href={site.ocraDonate} rel="noopener">Donate via OCRA<span aria-hidden="true"> ↗</span></a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
      toggle.querySelector('.label')!.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { set(false); toggle.focus(); }
    });
    matchMedia('(min-width: 1000px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--night); color: #fff; }
  .skip {
    position: absolute; left: 1rem; top: -100px; z-index: 60;
    background: var(--peach); color: var(--ink); padding: 0.7rem 1rem; border-radius: 8px; font-weight: 700;
  }
  .skip:focus { top: 0.75rem; }
  .bar {
    height: var(--header-h);
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding-inline: var(--gutter);
    max-width: 1440px; margin-inline: auto;
  }
  .brand img { height: 60px; width: auto; }
  .desktop { display: none; }
  .desktop ul { display: flex; gap: clamp(1.25rem, 2.4vw, 2.5rem); list-style: none; padding: 0; align-items: center; }
  .desktop ul a {
    font-weight: 700; font-size: 0.875rem; letter-spacing: 0.09em; text-transform: uppercase;
    text-decoration: none; padding-block: 0.5rem;
    background: linear-gradient(var(--peach), var(--peach)) left bottom / 0 2px no-repeat;
    transition: background-size var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }
  .desktop ul a:hover { background-size: 100% 2px; }
  .desktop ul a[aria-current='page'] { color: var(--peach); background-size: 100% 2px; }
  .desktop ul a.donate {
    text-transform: none; letter-spacing: 0; font-weight: 500; font-size: 0.95rem; color: #eadcef;
  }
  .desktop .join { min-height: 46px; padding: 0.7em 1.4em; font-size: 0.875rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .desktop .join[aria-current='page'] { background: var(--paper); color: var(--purple); border-color: var(--paper); }

  .menu-toggle {
    display: inline-flex; align-items: center; gap: 0.5rem;
    min-height: 48px; padding: 0 0.9rem 0 0.75rem;
    background: transparent; color: #fff; border: 1.5px solid rgb(255 255 255 / 0.35); border-radius: var(--radius-pill);
    font-weight: 700; font-size: 0.95rem;
  }
  .menu-toggle svg path { transition: transform var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out); transform-origin: center; }
  .menu-toggle[aria-expanded='true'] .l1 { transform: translateY(5px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .l2 { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .l3 { transform: translateY(-5px) rotate(-45deg); }

  .mobile-menu {
    position: fixed; inset: var(--header-h) 0 0 0; background: var(--night); overflow-y: auto;
    padding: 1.5rem var(--gutter) 3rem;
  }
  .mobile-menu nav { display: flex; flex-direction: column; gap: 1.75rem; max-width: 30rem; }
  .mobile-menu .btn { width: 100%; }
  .mobile-menu ul { list-style: none; padding: 0; display: grid; }
  .mobile-menu ul a {
    display: block; padding: 0.85rem 0; border-bottom: 1px solid rgb(255 255 255 / 0.14);
    font-family: var(--font-display); font-size: 2rem; line-height: 1.1; text-decoration: none;
  }
  .mobile-menu ul a[aria-current='page'] { color: var(--peach); }
  .mobile-menu .donate { color: #eadcef; font-weight: 500; }

  @media (min-width: 1000px) {
    .desktop { display: flex; align-items: center; gap: clamp(1.5rem, 2.6vw, 2.75rem); }
    .menu-toggle, .mobile-menu { display: none; }
  }
  :global(html.menu-open) { overflow: hidden; }
</style>

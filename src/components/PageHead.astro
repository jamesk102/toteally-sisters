---
/** Page opening: board ground, H1, lede, optional pinned photo. */
import Print from './Print.astro';
import type { ImageMetadata } from 'astro';
interface Props { title: string; lede?: string; photo?: ImageMetadata; photoAlt?: string; position?: string }
const { title, lede, photo, photoAlt = '', position } = Astro.props;
---
<section class="page-head ground-board">
  <div class="wrap inner" class:list={{ 'has-photo': !!photo }}>
    <div>
      <h1 set:html={title} />
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {photo && <Print src={photo} alt={photoAlt} tilt={2} tape="teal" settle={0} loading="eager" position={position} sizes="(min-width: 1000px) 34vw, 86vw" />}
  </div>
</section>

<style>
  .page-head { padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(3rem, 2rem + 4vw, 5rem); }
  .inner { display: grid; gap: 2.5rem; align-items: center; }
  h1 { max-width: 14ch; }
  .lede { margin-top: 1.25rem; max-width: 36rem; }
  .inner :global(.print) { aspect-ratio: 4 / 3; max-width: 32rem; }
  @media (min-width: 1000px) { .has-photo { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; } }
</style>

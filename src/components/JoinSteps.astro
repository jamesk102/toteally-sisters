---
/** How joining works, in three plain steps. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<ol class:list={['steps', cls]} aria-label="How joining works">
  <li><span class="n" aria-hidden="true">1</span><span>Tell us a little about you</span></li>
  <li><span class="n" aria-hidden="true">2</span><span>A sister emails you a hello and the Zoom link</span></li>
  <li><span class="n" aria-hidden="true">3</span><span>Come as you are, camera on or off</span></li>
</ol>

<style>
  .steps { list-style: none; padding: 0; display: grid; gap: 1rem 2.25rem; }
  li { display: flex; align-items: baseline; gap: 0.6rem; font-size: 1rem; line-height: 1.4; max-width: 17rem; }
  .n { font-family: var(--font-display); font-size: 2.75rem; line-height: 0.8; color: var(--purple); min-width: 1.4ch; }
  @media (min-width: 700px) { .steps { grid-auto-flow: column; grid-auto-columns: max-content; } }
</style>

---
import logo from '../assets/brand/logo.svg';
import ocra from '../assets/brand/ocra-partner.svg';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="wrap grid">
    <div class="about">
      <a href="/" aria-label="Toteally Sisters, home"><img src={logo.src} width="176" height="80" alt="" /></a>
      <p>A community rooted in connection, courage and care for every woman affected by gynecologic cancer.</p>
      <a class="btn btn--light" href="/join">Join a meetup</a>
    </div>

    <nav aria-label="Footer">
      <p class="col-title">Find your way</p>
      <ul>
        <li><a href="/our-story">Our Story</a></li>
        <li><a href="/monthly-meetup">Monthly Meetup</a></li>
        <li><a href="/events">Events</a></li>
        <li><a href="/in-the-news">In the News</a></li>
        <li><a href="/join">Join</a></li>
      </ul>
    </nav>

    <div>
      <p class="col-title">Follow along</p>
      <ul class="social">
        <li><a href={site.instagram} rel="noopener"><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>Instagram</a></li>
        <li><a href={site.facebook} rel="noopener"><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/></svg>Facebook</a></li>
      </ul>
      <p class="col-title">Support research</p>
      <a class="ocra" href={site.ocraHome} rel="noopener">
        <img src={ocra.src} width="200" height="50" alt="Ovarian Cancer Research Alliance, community partner" />
      </a>
      <p class="small">Donations go directly to the Ovarian Cancer Research Alliance. <a href={site.ocraDonate} rel="noopener">Donate via OCRA</a></p>
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} Toteally Sisters</p>
    <ul>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/terms">Terms</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: var(--night); color: #f3e8f2; padding-block: clamp(3.5rem, 6vw, 5.5rem) calc(2.5rem + 80px + env(safe-area-inset-bottom)); }
  .grid { display: grid; gap: 2.75rem; }
  .about img { height: 64px; width: auto; }
  .about p { margin-block: 1.25rem 1.5rem; max-width: 30ch; font-size: var(--step-0); }
  .col-title { font-weight: 700; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--pink-strong); margin-bottom: 0.9rem; }
  ul { list-style: none; padding: 0; }
  nav ul { display: grid; gap: 0.35rem; }
  nav a, .social a { text-decoration: none; display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; }
  nav a:hover, .social a:hover { text-decoration: underline; text-decoration-color: var(--peach); }
  .social { display: grid; gap: 0.25rem; margin-bottom: 1.75rem; }
  .ocra { display: inline-block; background: #fff; padding: 0.6rem 0.8rem; border-radius: 10px; }
  .ocra img { height: 40px; width: auto; }
  .small { margin-top: 0.75rem; font-size: var(--step--1); color: #d9c8db; max-width: 34ch; }
  .legal {
    margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.14);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; font-size: var(--step--1); color: #d9c8db;
  }
  .legal ul { display: flex; gap: 1.5rem; }
  @media (min-width: 800px) { .grid { grid-template-columns: 1.4fr 1fr 1.2fr; } }
  @media (min-width: 1000px) { .site-footer { padding-bottom: 2.5rem; } }
</style>

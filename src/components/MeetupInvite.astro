---
/** The pinned peach invitation: the next monthly meetup and the primary action. */
import { meetup } from '../data/site';
import { formatDate } from '../lib/events';

interface Props { primary?: boolean; settle?: number; headingLevel?: 'h2' | 'h3' }
const { primary = false, settle, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
const next = meetup.next ? new Date(meetup.next) : null;
const upcoming = next && next.getTime() > Date.now() ? next : null;
---
<section
  class:list={['invite', { settle: settle !== undefined }]}
  style={`--i:${settle ?? 0}`}
  aria-labelledby="invite-title"
>
  <span class="pin" aria-hidden="true"></span>
  {upcoming ? (
    <H id="invite-title">Next meetup: <span class="date">{formatDate(upcoming, { weekday: 'long', year: undefined })}</span></H>
  ) : (
    <H id="invite-title">Meet us on Zoom, <em>once a month</em></H>
  )}
  <p>
    {meetup.time ? <>{meetup.time} on Zoom. </> : null}
    Free. Keep your camera off and just listen if you like.
    {!upcoming && <> We'll email you the next date and link when you join.</>}
  </p>
  <a class="btn" href="/join" data-primary-cta={primary ? 'true' : undefined}>Join a meetup</a>
  <a class="more" href="/monthly-meetup">What to expect</a>
</section>

<style>
  .invite {
    position: relative;
    background: var(--peach);
    padding: clamp(1.4rem, 1rem + 1.2vw, 1.8rem);
    transform: rotate(-1.2deg);
    box-shadow: var(--shadow-card);
    max-width: 22rem;
  }
  .pin {
    position: absolute; top: -9px; left: 1.75rem;
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--purple);
    box-shadow: 0 3px 5px rgb(18 12 20 / 0.35);
  }
  h2, h3 { font-size: clamp(2rem, 1.6rem + 1vw, 2.6rem); line-height: 1.02; }
  .date { color: var(--purple); }
  p { margin-top: 0.75rem; font-size: 1rem; line-height: 1.5; }
  .btn { margin-top: 1.25rem; width: 100%; }
  .more {
    display: block; margin-top: 0.85rem; text-align: center; font-weight: 700; font-size: 0.98rem;
    text-decoration-color: var(--ink); min-height: 44px; line-height: 44px;
  }
  .more:hover { text-decoration-color: var(--purple); color: var(--purple-deep); }
  @media (prefers-reduced-motion: no-preference) {
    .settle { animation: drop 640ms var(--ease-settle) both; animation-delay: calc(var(--i) * 70ms + 80ms); }
    @keyframes drop {
      from { opacity: 0; transform: translateY(-16px) rotate(-4deg); }
      to { opacity: 1; transform: rotate(-1.2deg); }
    }
  }
</style>

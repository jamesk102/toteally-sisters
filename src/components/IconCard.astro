---
/** White card with the original's 8px pink border and line icon (home "initiatives" and OFO "classes"). */
interface Props { icon: string; title: string; delay?: number; size?: 'lg' | 'md' }
const { icon, title, delay = 0, size = 'lg' } = Astro.props;
---
<article class:list={['icon-card', size]} data-fade style={`--fade-delay:${delay}ms`}>
  <span class="icon" aria-hidden="true" set:html={icon} />
  <h3 class="h-card">{title}</h3>
  <p class="text"><slot /></p>
</article>

<style>
  .icon-card { background: #fff; border: 8px solid var(--pink); border-radius: 50px; padding: 30px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .icon :global(svg) { width: 60px; height: 60px; }
  .h-card { color: #000; }
  .text { color: #000; }
  @media (max-width: 767px) { .icon-card { padding: 30px 20px; gap: 15px; } .icon :global(svg) { width: 50px; height: 50px; } }
</style>

---
import Base from '../../layouts/Base.astro';
---
<Base title="Thank you" noindex>
  <section class="section" style="background: rgb(235 186 217 / 0.34)">
    <div class="center" style="max-width: 750px; margin-inline: auto; display: grid; gap: 15px; justify-items: center;">
      <h1 class="h-xl">Thank you!</h1>
      <p class="text-lg">Your message was sent. A member from our team will be in touch.</p>
      <a class="btn" href="/" style="margin-top: 20px;">Back to Home</a>
    </div>
  </section>
</Base>

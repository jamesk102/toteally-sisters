---
import Arrow from '../components/Arrow.astro';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Print from '../components/Print.astro';
import JoinSteps from '../components/JoinSteps.astro';
import { meetup } from '../data/site';
import zoom from '../assets/photos/zoom-meetup.png';
import tealDay from '../assets/photos/wear-teal-day.jpg';

const when = meetup.schedule
  ? `${meetup.schedule}${meetup.time ? `, ${meetup.time}` : ''}`
  : 'Once a month. We email the date and link when you join.';

const faqs = [
  { q: 'Do I have to talk?', a: 'No. Plenty of women spend their first meetup just listening. Share when, and if, you want to.' },
  { q: 'Do I have to turn my camera on?', a: 'No. Camera off is completely fine. So is joining from bed, the car or a waiting room.' },
  { q: 'My cancer isn’t ovarian. Is this for me?', a: 'Yes. Ovarian, uterine, cervical, vulvar and every other gynecologic cancer, at any stage, newly diagnosed, in treatment or years after.' },
  { q: 'Can my partner, daughter or friend come?', a: 'Yes. Caregivers and loved ones are welcome, with you or on their own.' },
  { q: 'Is it medical advice?', a: 'No. It’s peer support from women who have been there. For medical questions, please talk with your care team.' },
  { q: 'What does it cost?', a: 'Nothing. The meetup is free, always.' },
];
---
<Base title="Monthly Meetup" description="A free monthly Zoom meetup for women facing any gynecologic cancer, and the people who love them. Cameras optional.">
  <PageHead
    title="A seat saved for you, <em>every month</em>"
    lede="Our monthly meetup is a free Zoom call for women facing gynecologic cancer, and the people who love them. Come to talk, laugh, listen, or just be around people who understand."
    photo={zoom}
    photoAlt="Ten women smiling in a Zoom gallery view during a Toteally Sisters meetup."
    position="top"
  >
    <div class="next-step"><a class="btn" href="/join" data-primary-cta="true">Join a meetup</a></div>
  </PageHead>

  <section class="section" aria-labelledby="details-title">
    <div class="wrap details">
      <h2 id="details-title">The details</h2>
      <dl>
        <div><dt>When</dt><dd>{when}</dd></div>
        {meetup.length && <div><dt>How long</dt><dd>{meetup.length}</dd></div>}
        <div><dt>Where</dt><dd>On Zoom, from wherever you are</dd></div>
        <div><dt>Cost</dt><dd>Free</dd></div>
        <div><dt>Who it’s for</dt><dd>Women facing any gynecologic cancer, at any stage, and their caregivers</dd></div>
        <div><dt>Started by</dt><dd>Survivors Sherry Baird and Mai Linh Nguyen Achong</dd></div>
      </dl>
    </div>
  </section>

  <section class="section ground-peach" aria-labelledby="first-title">
    <div class="wrap first">
      <div>
        <h2 id="first-title">Your first time</h2>
        <p class="lede">Nervous is normal. Here’s how it works.</p>
        <JoinSteps class="first-steps" />
        <div class="next-step"><a class="btn" href="/join">Join a meetup</a></div>
      </div>
      <Print src={tealDay} alt="A collage of smiling women wearing teal for National Wear Teal Day." tilt={-2} tape="pink" sizes="(min-width: 1000px) 30vw, 86vw" />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 id="faq-title">Questions women ask us</h2>
      <div class="faqs">
        {faqs.map((f) => (
          <details>
            <summary><span>{f.q}</span><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <div class="next-step">
        <a class="btn" href="/join">Join a meetup</a>
        <a class="link-arrow" href="/our-story">Meet the founders <Arrow /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .details dl { margin-top: 2rem; display: grid; border-top: 1px solid var(--line); max-width: 52rem; }
  .details dl > div { display: grid; gap: 0.25rem 2rem; padding-block: 1.1rem; border-bottom: 1px solid var(--line); }
  dt { font-weight: 700; }
  @media (min-width: 700px) { .details dl > div { grid-template-columns: 12rem 1fr; } }
  .first { display: grid; gap: 3rem; align-items: center; }
  .first .lede { margin-top: 1rem; }
  .first :global(.first-steps) { margin-top: 2rem; grid-auto-flow: row; }
  .first :global(.print) { aspect-ratio: 1; max-width: 28rem; }
  @media (min-width: 1000px) { .first { grid-template-columns: 1.1fr 0.9fr; gap: 5rem; } }
  .faqs { margin-top: 2rem; max-width: 52rem; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding-block: 1.15rem; min-height: 56px; font-family: var(--font-display); font-size: var(--step-2); line-height: 1.15;
  }
  summary::-webkit-details-marker { display: none; }
  summary svg { flex: none; transition: transform var(--dur) var(--ease-out); }
  details[open] summary svg { transform: rotate(180deg); }
  summary:hover span { text-decoration: underline; text-decoration-color: var(--pink-strong); text-decoration-thickness: 2px; }
  details p { padding-bottom: 1.25rem; max-width: var(--measure); }
</style>

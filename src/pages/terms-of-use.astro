---
import Base from '../layouts/Base.astro';
---
<Base title="Terms of Use" description="Terms of use for the Toteally Sisters website.">
  <section class="section legal-page">
    <div class="legal" data-fade>
      <h1 class="h-xl">Terms of Use</h1>
      <p class="text-lg">By using this website, you agree to the terms below.</p>
      <p class="updated">Last updated November 2026</p>

      <h2>Use of this site</h2>
      <p>This website shares general information about Toteally Sisters. Please use it for lawful, personal purposes only.</p>

      <h2>Not medical advice</h2>
      <p>Nothing on this website is medical, legal or financial advice. Always talk with a qualified professional about your health.</p>

      <h2>Content</h2>
      <p>The text, photos and graphics on this site belong to Toteally Sisters or are used with permission. Please ask before reusing them.</p>

      <h2>Links to other websites</h2>
      <p>This site links to other websites, such as social media and partner organizations. We aren’t responsible for their content or practices.</p>

      <h2>No guarantees</h2>
      <p>We work to keep this site accurate and available, but it is provided “as is,” without warranties of any kind.</p>

      <h2>Changes</h2>
      <p>We may update these terms from time to time. The date above shows the latest version.</p>
    </div>
  </section>
</Base>

<style>
  .legal-page { background: rgb(235 186 217 / 0.24); }
  .legal { max-width: 800px; margin-inline: auto; background: #fff; border-radius: 30px; padding: 60px; }
  .legal :global(h2) { font-family: var(--serif); font-weight: 400; font-size: var(--h-sm); line-height: var(--h-sm-lh); letter-spacing: -1px; margin-top: 40px; }
  .legal :global(p), .legal :global(li) { font-size: 18px; line-height: 28px; margin-top: 12px; }
  .legal .text-lg { margin-top: 20px; font-size: var(--text-lg); line-height: var(--text-lg-lh); }
  .updated { color: #555; font-size: 15px !important; }
  .legal :global(ul) { padding-left: 1.2rem; }
  @media (max-width: 767px) { .legal { padding: 30px 20px; border-radius: 20px; } .legal-page { padding-inline: 20px; } }
</style>

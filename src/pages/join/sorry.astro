---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
---
<Base title="That didn’t send" hideJoinBar>
  <section class="section ground-board">
    <div class="wrap prose">
      <h1>Sorry, that <em>didn’t send.</em></h1>
      <p class="lede">Please go back and check that your first name, last name and email are filled in, then try again. If it keeps happening, message us on <a href={site.instagram} rel="noopener">Instagram</a> or <a href={site.facebook} rel="noopener">Facebook</a> and we’ll reach out.</p>
      <div class="next-step"><a class="btn" href="/join">Back to the form</a></div>
    </div>
  </section>
</Base>

---
import Arrow from '../../components/Arrow.astro';
import Base from '../../layouts/Base.astro';
---
<Base title="Thank you" hideJoinBar>
  <section class="section ground-board">
    <div class="wrap prose">
      <h1>Thank you. <em>We’re so glad you’re here.</em></h1>
      <p class="lede">A sister will email you soon with a hello and the link to our next monthly meetup. Keep an eye on your inbox, and your spam folder, just in case.</p>
      <div class="next-step">
        <a class="btn" href="/our-story">Read our story</a>
        <a class="link-arrow" href="/monthly-meetup">What to expect <Arrow /></a>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import Print from '../../components/Print.astro';
import JoinSteps from '../../components/JoinSteps.astro';
import { iAmOptions, heardOptions, meetupOptions, labels } from '../../lib/join-form';
import { site } from '../../data/site';
import zoom from '../../assets/photos/zoom-meetup.png';
---
<Base title="Join" description="Join Toteally Sisters. Tell us a little about you and a sister will email you a hello and the link to our free monthly Zoom meetup." hideJoinBar>
  <section class="join ground-board">
    <div class="wrap layout">
      <div class="intro">
        <h1>Come <em>connect</em> with us</h1>
        <p class="lede">Tell us a little about you. A sister will email you a hello and the link to our next free monthly meetup on Zoom.</p>
        <JoinSteps class="join-steps" />
        <Print class="intro-photo" src={zoom} alt="Women smiling in a Zoom gallery view during a Toteally Sisters meetup." tilt={-2} tape="pink" position="top" sizes="(min-width: 1000px) 26vw, 1px" />
      </div>

      <div class="card">
        <form id="join-form" action="/api/join" method="post" novalidate>
          <div class="summary" role="alert" tabindex="-1" hidden>
            <h2>A couple of things to fix</h2>
            <ul></ul>
          </div>

          <p class="req-note">Only your name and email are needed. Everything else is optional.</p>

          <div class="row two">
            <div class="field">
              <label for="firstName">{labels.firstName} <span class="req">(required)</span></label>
              <input id="firstName" name="firstName" autocomplete="given-name" required aria-describedby="firstName-err" />
              <p class="err" id="firstName-err"></p>
            </div>
            <div class="field">
              <label for="lastName">{labels.lastName} <span class="req">(required)</span></label>
              <input id="lastName" name="lastName" autocomplete="family-name" required aria-describedby="lastName-err" />
              <p class="err" id="lastName-err"></p>
            </div>
          </div>

          <div class="field">
            <label for="email">{labels.email} <span class="req">(required)</span></label>
            <input id="email" name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" required aria-describedby="email-hint email-err" />
            <p class="hint" id="email-hint">This is where we’ll send the meetup link.</p>
            <p class="err" id="email-err"></p>
          </div>

          <div class="row two">
            <div class="field">
              <label for="phone">{labels.phone}</label>
              <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" />
            </div>
            <div class="field">
              <label for="location">{labels.location}</label>
              <input id="location" name="location" autocomplete="address-level2" placeholder="e.g. Orlando, FL" />
            </div>
          </div>

          <fieldset class="field">
            <legend>{labels.iAm}</legend>
            <div class="choices">
              {iAmOptions.map((o) => (
                <label class="choice"><input type="radio" name="iAm" value={o} /><span>{o}</span></label>
              ))}
            </div>
          </fieldset>

          <div class="field">
            <label for="cancerType">{labels.cancerType}</label>
            <input id="cancerType" name="cancerType" aria-describedby="cancer-hint" />
            <p class="hint" id="cancer-hint">Only if you’re comfortable sharing. Every gynecologic cancer is welcome.</p>
          </div>

          <div class="field">
            <label for="hopes">{labels.hopes}</label>
            <textarea id="hopes" name="hopes" rows="4" placeholder="Community, someone to talk to, a place to just listen…"></textarea>
          </div>

          <div class="field">
            <label for="heard">{labels.heard}</label>
            <div class="select">
              <select id="heard" name="heard">
                <option value="">Choose one</option>
                {heardOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </div>
          </div>

          <fieldset class="field">
            <legend>{labels.meetup}</legend>
            <div class="choices">
              {meetupOptions.map((o) => (
                <label class="choice"><input type="radio" name="meetup" value={o} /><span>{o}</span></label>
              ))}
            </div>
          </fieldset>

          <div class="field">
            <label for="more">{labels.more}</label>
            <textarea id="more" name="more" rows="3"></textarea>
          </div>

          <div class="hp" aria-hidden="true">
            <label for="website">Leave this empty</label>
            <input id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="started" value="" />

          <div class="privacy">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
            <p>Your answers go only to the small Toteally Sisters team. We never sell or share them. <a href="/privacy">How we handle your information</a></p>
          </div>

          <button class="btn submit" type="submit">
            <span class="label">Send, I’d like to connect</span>
            <span class="sending" aria-hidden="true">Sending…</span>
          </button>
          <p class="status" role="status" aria-live="polite"></p>
        </form>

        <div class="thanks" tabindex="-1" hidden>
          <h2>Thank you. <em>We’re so glad you’re here.</em></h2>
          <p>A sister will email you soon with a hello and the link to our next monthly meetup. Keep an eye on your inbox, and your spam folder, just in case.</p>
          <p>Until then, you might like to read how it all started.</p>
          <div class="next-step">
            <a class="btn" href="/our-story">Read our story</a>
            <a class="link-arrow" href="/monthly-meetup">What to expect <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ instagram: site.instagram }}>
  const form = document.getElementById('join-form');
  const summary = form.querySelector('.summary');
  const status = form.querySelector('.status');
  const thanks = document.querySelector('.thanks');
  form.started.value = String(Date.now());

  const setError = (name, msg) => {
    const input = form.elements[name];
    const err = document.getElementById(name + '-err');
    if (!input || !err) return;
    input.setAttribute('aria-invalid', msg ? 'true' : 'false');
    err.textContent = msg || '';
  };
  const check = () => {
    const errors = {};
    const v = (n) => form.elements[n].value.trim();
    if (!v('firstName')) errors.firstName = 'Please tell us your first name.';
    if (!v('lastName')) errors.lastName = 'Please tell us your last name.';
    if (!v('email')) errors.email = 'We need an email to send you the meetup link.';
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v('email'))) errors.email = 'That email doesn’t look quite right. Check for a typo?';
    return errors;
  };
  const showErrors = (errors) => {
    ['firstName', 'lastName', 'email'].forEach((n) => setError(n, errors[n]));
    const keys = Object.keys(errors);
    const ul = summary.querySelector('ul');
    ul.innerHTML = '';
    keys.forEach((k) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '#' + k; a.textContent = errors[k];
      li.append(a); ul.append(li);
    });
    summary.hidden = keys.length === 0;
    if (keys.length) summary.focus();
  };

  // Re-check a field once the person leaves it, but only after they've tried to send.
  let tried = false;
  form.addEventListener('focusout', (e) => {
    if (!tried || !['firstName', 'lastName', 'email'].includes(e.target.name)) return;
    setError(e.target.name, check()[e.target.name]);
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    tried = true;
    const errors = check();
    if (Object.keys(errors).length) return showErrors(errors);
    showErrors({});
    form.classList.add('is-sending');
    form.querySelector('.submit').disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const body = await res.json().catch(() => ({}));
      if (res.ok && body.ok) {
        form.hidden = true;
        thanks.hidden = false;
        thanks.focus();
        thanks.scrollIntoView({ block: 'start' });
        return;
      }
      if (body.error === 'invalid' && body.errors) { showErrors(body.errors); status.textContent = ''; }
      else throw new Error(body.error || 'failed');
    } catch {
      status.innerHTML = '';
      status.append('Sorry, that didn’t send. Your answers are still here, so please try again in a moment. If it keeps happening, message us on ');
      const a = document.createElement('a'); a.href = instagram; a.textContent = 'Instagram'; status.append(a, '.');
    } finally {
      form.classList.remove('is-sending');
      form.querySelector('.submit').disabled = false;
    }
  });
</script>

<style>
  .join { padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem) var(--section); }
  .layout { display: grid; gap: 2.5rem; align-items: start; }
  .intro .lede { margin-top: 1.25rem; max-width: 32rem; }
  .intro :global(.join-steps) { margin-top: 2rem; grid-auto-flow: row; }
  .intro :global(.intro-photo) { display: none; }
  @media (min-width: 1000px) {
    .layout { grid-template-columns: 0.85fr 1.15fr; gap: 4.5rem; }
    .intro { position: sticky; top: calc(var(--header-h) + 2.5rem); }
    .intro :global(.intro-photo) { display: block; margin-top: 3rem; aspect-ratio: 4 / 3; max-width: 22rem; }
  }

  .card { background: var(--paper); padding: clamp(1.4rem, 0.8rem + 2.5vw, 2.75rem); box-shadow: var(--shadow-card); border-radius: 4px; }
  .req-note { color: var(--ink-soft); margin-bottom: 1.5rem; }
  .row.two { display: grid; gap: 0 1.25rem; }
  @media (min-width: 640px) { .row.two { grid-template-columns: 1fr 1fr; } }
  .field { margin-bottom: 1.5rem; border: 0; padding: 0; min-width: 0; }
  label, legend { display: block; font-weight: 700; line-height: 1.35; margin-bottom: 0.5rem; padding: 0; }
  .req { font-weight: 500; color: var(--ink-soft); }
  input:not([type='radio']), textarea, select {
    width: 100%; min-height: 54px; padding: 0.75rem 1rem;
    font-size: max(16px, 1.05rem);
    background: #fff; border: 1.5px solid #a99aab; border-radius: 10px;
    transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  textarea { resize: vertical; line-height: 1.5; }
  input::placeholder, textarea::placeholder { color: #6e5f71; }
  input:not([type='radio']):hover, textarea:hover, select:hover { border-color: var(--ink-soft); }
  input:not([type='radio']):focus-visible, textarea:focus-visible, select:focus-visible {
    outline: none; border-color: var(--purple); box-shadow: 0 0 0 3px rgb(103 59 152 / 0.35);
  }
  [aria-invalid='true'] { border-color: #b3261e !important; }
  .hint { margin-top: 0.45rem; font-size: var(--step--1); color: var(--ink-soft); }
  .err { margin-top: 0.45rem; font-size: var(--step--1); font-weight: 700; color: #b3261e; }
  .err:empty { display: none; }

  .select { position: relative; }
  .select select { appearance: none; padding-right: 3rem; }
  .select svg { position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); pointer-events: none; }

  .choices { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .choice { position: relative; margin: 0; font-weight: 600; }
  .choice input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .choice span {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0.55rem 1.1rem;
    border: 1.5px solid #a99aab; border-radius: var(--radius-pill); background: #fff;
    transition: background-color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }
  .choice:hover span { border-color: var(--purple); }
  .choice input:checked + span { background: var(--purple); border-color: var(--purple); color: #fff; }
  .choice input:focus-visible + span { outline: 3px solid var(--purple); outline-offset: 3px; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .privacy { display: flex; gap: 0.75rem; align-items: flex-start; background: var(--pink); padding: 1rem 1.1rem; border-radius: 10px; margin-block: 0.5rem 1.5rem; }
  .privacy svg { flex: none; margin-top: 0.15rem; color: var(--purple); }
  .privacy p { font-size: var(--step--1); }

  .submit { width: 100%; position: relative; }
  .submit .sending { display: none; }
  .is-sending .submit .label { display: none; }
  .is-sending .submit .sending { display: inline; }
  .submit:disabled { opacity: 0.75; cursor: progress; }
  .status { margin-top: 1rem; }
  .status:empty { display: none; }

  .summary { border: 2px solid #b3261e; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; background: #fff5f4; }
  .summary h2 { font-family: var(--font-body); font-weight: 700; font-size: 1.05rem; letter-spacing: 0; }
  .summary ul { margin-top: 0.5rem; padding-left: 1.2rem; }
  .summary a { color: #8c1d18; font-weight: 600; }

  .thanks h2 { font-size: var(--step-3); }
  .thanks p { margin-top: 1rem; max-width: 34rem; }
  .thanks:focus { outline: none; }
  [hidden] { display: none !important; }
</style>

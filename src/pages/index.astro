---
import Base from '../layouts/Base.astro';
import Slideshow from '../components/Slideshow.astro';
import IconCard from '../components/IconCard.astro';
import Arrow from '../components/Arrow.astro';
import virtualIcon from '../icons/virtual-meetups.svg?raw';
import eventsIcon from '../icons/in-person-events.svg?raw';
import collabIcon from '../icons/collaborate.svg?raw';
import { getEntry } from 'astro:content';
import { formatDate } from '../lib/events';

// Ovarian Fitness Orlando is featured on the home page, as on the original site.
const ofo = await getEntry('events', 'ovarian-fitness-orlando');
---
<Base title="Toteally Sisters">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-copy" data-fade>
      <h1 class="h-xl cap">united in teal,<br />stronger together</h1>
      <p class="text-lg">We empower women navigating the challenges of gynecological cancer through community and shared experiences. Join us to find strength, support, and lasting connections.</p>
      <a class="btn" href="/get-involved/">Join the Sisterhood <Arrow /></a>
    </div>
    <Slideshow class="hero-media" eager slides={[
      { src: '/images/imageHero.jpg', alt: 'Toteally Sisters in matching teal shirts at a cycling fundraiser.', position: '50% 100%' },
      { src: '/images/toteallyDisney.jpg', alt: 'Three Toteally Sisters in teal shirts and Mickey ears by the lake.', position: '50% 100%' },
      { src: '/images/toteally-building.jpg', alt: 'A group of Toteally Sisters in teal outside a building lit up at night.', position: '50% 100%' },
    ]} />
  </section>

  <!-- Fueling Hope -->
  <section class="hope on-dark">
    <div class="hope-inner">
      <div class="hope-title" data-fade>
        <h2 class="hope-heading">Fueling Hope, <em>Together.</em></h2>
        <a class="btn btn--outline" href="/sister-support/">Learn More <Arrow /></a>
      </div>
      <div class="hope-text" data-fade style="--fade-delay:120ms">
        <p>Our mission is rooted in care beyond the diagnosis—uplifting the minds, hearts, and spirits of women facing gynecological cancers, along with the people who love them. Through awareness, education, and shared stories, we’re creating space for healing and honest connection.</p>
        <p>Get to know how <strong>Toteally Sisters</strong> began—and how this community continues to change lives, one relationship at a time.</p>
      </div>
    </div>
    <div class="dots" aria-hidden="true"></div>
  </section>

  <!-- Ovarian Fitness Orlando -->
  {ofo && (
    <section class="section ribbons ofo">
      <div class="two-col wrap">
        <div data-fade>
          <h2 class="h-xl cap">Move for a Cure at Ovarian Fitness Orlando</h2>
          <div class="text-lg body">
            <p>Join us on {formatDate(ofo.data.start, { weekday: 'long' })} for a powerful day of spin, dance, and yoga—all in support of ovarian and gynecologic cancer research.</p>
            <p>Pick your class, fundraise with your team, and help us hit our $20,000 goal.</p>
          </div>
          <a class="btn" href="/ovarian-fitness-orlando/">View Event Details <Arrow /></a>
        </div>
        <div data-fade style="--fade-delay:120ms">
          <Slideshow class="ofo-media" slides={[
            { src: '/images/caitlinSherryJames.jpg', alt: 'Three riders smiling together on spin bikes in a teal-lit studio.' },
            { src: '/images/holdingOcraBags.jpg', alt: 'Two women holding teal OCRA tote bags outside the studio.' },
            { src: '/images/maiRaffleBasket.jpg', alt: 'Two women holding up a raffle basket at a vendor table.' },
            { src: '/images/scottOnBike.jpg', alt: 'A rider on a spin bike during an Ovarian Fitness Orlando class.' },
            { src: '/images/yogaSession.jpg', alt: 'Women in a yoga class raising their arms overhead in blue light.' },
          ]} />
        </div>
      </div>
    </section>
  )}

  <!-- Monthly Virtual Meetups -->
  <section class="section meetups">
    <div class="two-col wrap">
      <div class="meetups-copy" data-fade>
        <h2 class="h-xl cap">Monthly Virtual Meetups</h2>
        <p class="text-lg body">No matter where you are on your journey, you are not alone. Join our free monthly Zoom calls to connect, share, and support one another.</p>
        <a class="btn" href="/get-involved/">Get Involved <Arrow /></a>
      </div>
      <div class="meetups-media" data-fade style="--fade-delay:120ms">
        <img src="/images/meet-ups-1.png" width="1215" height="1851" loading="lazy" decoding="async" alt="Ten women smiling in a Zoom gallery view during a monthly Toteally Sisters meetup, one holding a Good Vibes Only neon sign." />
      </div>
    </div>
  </section>

  <!-- Together -->
  <section class="section together on-dark">
    <div class="wrap">
      <div class="together-head center" data-fade>
        <span class="pill">Together</span>
        <h2 class="together-heading">Empowering Women Through<br />Connection and Support</h2>
        <p class="text-lg">We believe in the power of community. Our initiatives are designed to provide education, support, and a sense of belonging for women affected by gynecologic cancers.</p>
      </div>
      <div class="cards">
        <IconCard icon={virtualIcon} title="Join Our Virtual Meetups for Connection">Engage with fellow survivors and fighters in a safe, supportive online environment.</IconCard>
        <IconCard icon={eventsIcon} title="Participate in Our Inspiring In-Person Events" delay={100}>Experience the joy of connection and empowerment at our gatherings.</IconCard>
        <IconCard icon={collabIcon} title="Collaborate with Leading Research and Advocacy Groups" delay={200}>Together, we can drive awareness and support crucial research.</IconCard>
      </div>
    </div>
  </section>

  <!-- Our Team -->
  <section class="section team">
    <div class="wrap center">
      <div data-fade>
        <h2 class="h-xl team-heading">Our Team</h2>
        <p class="text-lg">Meet the dedicated individuals behind Toteally Sisters.</p>
      </div>
      <div class="members">
        <article class="member" data-fade>
          <img src="/images/sherry.png" width="500" height="500" loading="lazy" decoding="async" alt="Sherry Baird in heart-shaped teal sunglasses, smiling." />
          <h3 class="h-sm">Sherry Baird</h3>
          <p class="role">Survivor &amp; Advocate</p>
          <p class="text">Passionate about empowering women through support and education.</p>
          <ul class="member-social">
            <li><a href="https://www.facebook.com/sherry.baird1" rel="noopener" aria-label="Sherry Baird on Facebook"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-1.6 19.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 12 2z"/></svg></a></li>
            <li><a href="https://www.instagram.com/sasbaird23/" rel="noopener" aria-label="Sherry Baird on Instagram"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a></li>
            <li><a href="https://www.linkedin.com/in/sherry-baird-776071165/" rel="noopener" aria-label="Sherry Baird on LinkedIn"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4V21H3zM9.5 9.75h3.8v1.6h.06c.53-1 1.84-2.06 3.78-2.06 4.05 0 4.8 2.66 4.8 6.12V21h-4v-4.95c0-1.18-.02-2.7-1.65-2.7-1.65 0-1.9 1.29-1.9 2.62V21h-4z"/></svg></a></li>
          </ul>
        </article>
        <article class="member" data-fade style="--fade-delay:120ms">
          <img src="/images/mai.jpg" width="320" height="320" loading="lazy" decoding="async" alt="Mai Linh Nguyen Achong in a teal top, smiling warmly." />
          <h3 class="h-sm">Mai Linh Nguyen Achong</h3>
          <p class="role">Survivor &amp; Advocate</p>
          <p class="text">Creating memorable experiences that foster community and connection.</p>
          <ul class="member-social">
            <li><a href="https://www.facebook.com/mai.linh.82" rel="noopener" aria-label="Mai Linh on Facebook"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-1.6 19.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 12 2z"/></svg></a></li>
            <li><a href="https://www.instagram.com/mai82life/" rel="noopener" aria-label="Mai Linh on Instagram"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a></li>
          </ul>
        </article>
      </div>
      <a class="btn" href="/our-story/" data-fade>Read Our Story</a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { display: grid; grid-template-columns: 1fr 1fr; min-height: 720px; background: rgb(235 186 217 / 0.46); }
  .hero-copy { align-self: center; padding: 100px 104px; display: grid; gap: 30px; justify-items: start; max-width: 720px; }
  .hero-copy h1 { max-width: 512px; }
  .hero-copy .text-lg { max-width: 512px; }
  .hero-copy .btn { margin-top: 20px; }
  :global(.hero-media) { min-height: 720px; }

  /* Fueling Hope */
  .hope { background: var(--navy); color: #fff; padding: 142px 80px 113px; }
  .hope-inner { max-width: 1280px; margin-inline: auto; display: grid; grid-template-columns: 366px 1fr; gap: 60px; align-items: start; }
  .hope-title { display: grid; justify-items: center; gap: 30px; text-align: center; }
  .hope-heading { font-family: var(--serif); font-weight: 400; font-size: 70px; line-height: 80px; letter-spacing: -2px; }
  .hope-text { font-size: 24px; line-height: 36px; }
  .dots { margin-top: 111px; height: 8px; background: radial-gradient(circle, #fff 2.6px, transparent 3px) 0 50% / 15px 8px repeat-x; margin-inline: -80px; }

  /* Two-column sections */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 60px 80px; align-items: center; }
  .two-col > div:first-child { display: grid; gap: 20px; justify-items: start; }
  .body { display: grid; gap: 0; }
  .two-col .btn { margin-top: 20px; }

  .ofo { padding: 125px 70px; }
  :global(.ofo-media) { aspect-ratio: 620 / 630; border: 8px solid var(--pink); border-radius: 100px; }

  .meetups { background: rgb(235 186 217 / 0.26); padding-inline: 70px; }
  .meetups .two-col { grid-template-columns: 650px 1fr; }
  .meetups-media { justify-self: end; max-width: 520px; }
  .meetups-media img { width: 100%; border-radius: 40px; }

  /* Together */
  .together { background: var(--purple); color: #fff; padding-block: 80px 121px; }
  .together-head { display: grid; justify-items: center; gap: 25px; max-width: 820px; margin-inline: auto; }
  .together-heading { font-family: var(--serif); font-weight: 400; font-size: 85px; line-height: 95px; letter-spacing: -2px; }
  .cards { margin-top: 60px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }

  /* Team */
  .team { background: rgb(235 186 217 / 0.21); padding-block: 106px; }
  .team-heading { font-style: italic; }
  .team .text-lg { margin-top: 20px; }
  .members { margin: 60px auto 60px; display: flex; justify-content: center; gap: 60px; flex-wrap: wrap; }
  .member { background: #fff; border-radius: 50px; padding: 30px 20px; width: 440px; display: grid; justify-items: center; gap: 10px; }
  .member img { width: 150px; height: 150px; border-radius: 50%; object-fit: cover; margin-bottom: 15px; }
  .role { font-family: var(--serif); font-style: italic; font-size: 24px; line-height: 30px; }
  .member .text { margin-top: 5px; max-width: 360px; }
  .member-social { list-style: none; padding: 0; display: flex; gap: 15px; margin-top: 15px; }
  .member-social a { display: inline-flex; width: 30px; height: 30px; color: #000; transition: color 200ms var(--ease); }
  .member-social a:hover { color: var(--purple); }
  .member-social svg { width: 30px; height: 30px; }

  @media (max-width: 1024px) {
    .hero { grid-template-columns: 1fr; }
    .hero-copy { order: 2; padding: 60px 40px 80px; max-width: none; }
    .hero-copy h1, .hero-copy .text-lg { max-width: none; }
    :global(.hero-media) { order: 1; min-height: 0; aspect-ratio: 1 / 0.75; }
    .hope { padding: 80px 40px 60px; }
    .hope-inner { grid-template-columns: 1fr; text-align: center; }
    .hope-text { text-align: center; }
    .dots { margin-inline: -40px; margin-top: 60px; }
    .two-col, .meetups .two-col { grid-template-columns: 1fr; }
    .ofo, .meetups { padding-inline: 40px; }
    .ofo { padding-block: 80px; }
    .ofo .two-col > div:last-child, .meetups-media { order: -1; justify-self: center; width: 100%; }
    .meetups-media { max-width: 520px; }
    .together-heading { font-size: 70px; line-height: 80px; }
    .cards { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
  }
  @media (max-width: 767px) {
    .hero-copy { padding: 40px 30px; gap: 20px; }
    .hero-copy .btn { margin-top: 10px; }
    :global(.hero-media) { aspect-ratio: 390 / 300; }
    .hope { padding: 40px 30px; }
    .hope-heading { font-size: 40px; line-height: 50px; }
    .hope-text { font-size: 17px; line-height: 25.5px; }
    .dots { margin-inline: -30px; margin-top: 40px; }
    .ofo { padding: 40px; }
    .meetups { padding-inline: 20px; }
    :global(.ofo-media) { max-width: 310px; margin-inline: auto; }
    .meetups-media { max-width: 300px; }
    .together { padding-block: 40px; }
    .team { padding-block: 40px; }
    .meetups-copy { justify-items: center !important; text-align: center; }
    :global(.ofo-media) { border-radius: 60px; }
    .together { padding-inline: 20px; }
    .together-heading { font-size: 40px; line-height: 50px; }
    .together-heading br { display: none; }
    .cards { margin-top: 40px; gap: 20px; }
    .team { padding-inline: 20px; }
    .members { gap: 30px; margin-block: 40px; }
    .member { width: 100%; }
    .role { font-size: 20px; }
  }
</style>

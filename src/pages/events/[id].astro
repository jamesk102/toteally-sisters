---
import Arrow from '../../components/Arrow.astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Print from '../../components/Print.astro';
import { formatDate, endOf } from '../../lib/events';
import { site } from '../../data/site';
import spin from '../../assets/photos/spin-friends.jpg';
import yoga from '../../assets/photos/yoga.jpg';
import studio from '../../assets/photos/spin-studio.jpg';
import poke from '../../assets/photos/poke.jpeg';
import raffle from '../../assets/photos/raffle.jpg';
import bags from '../../assets/photos/ocra-bags.jpg';

export async function getStaticPaths() {
  const events = await getCollection('events', (e) => e.data.hasPage);
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const isPast = endOf(event) < Date.now();
const isOfo = event.id === 'ovarian-fitness-orlando';
---
<Base title={event.data.title} description={event.data.summary}>
  <section class="head ground-board">
    <div class="wrap inner">
      <div>
        <p class="crumb"><a href="/events"><Arrow dir="left" /> All events</a></p>
        <h1>{event.data.title}</h1>
        <p class="when">{formatDate(event.data.start, { weekday: 'long' })} · {event.data.place}</p>
        {isPast && <p class="past-note">This event has passed. Thank you to everyone who came, moved and gave.</p>}
        <p class="lede">{event.data.summary}</p>
        <div class="next-step">
          {isPast ? (
            <>
              <a class="btn" href="/join" data-primary-cta="true">Join a meetup</a>
              <a class="link-arrow" href={site.ocraDonate} rel="noopener">Donate via OCRA <Arrow dir="out" /></a>
            </>
          ) : (
            <>
              <a class="btn" href={`${site.ocraHome}signup`} rel="noopener" data-primary-cta="true">Register on OCRA’s site <Arrow dir="out" /></a>
              <a class="link-arrow" href={site.ocraDonate} rel="noopener">Donate via OCRA <Arrow dir="out" /></a>
            </>
          )}
        </div>
      </div>
      <Print src={event.data.image} alt={event.data.imageAlt} tilt={2} tape="teal" settle={0} loading="eager" sizes="(min-width: 1000px) 34vw, 86vw" />
    </div>
  </section>

  <section class="section">
    <div class="wrap prose"><Content /></div>
  </section>

  {isOfo && (
    <section class="section ground-peach" aria-labelledby="day-title">
      <div class="wrap">
        <h2 id="day-title">The day, in pictures</h2>
        <ul class="gallery">
          <li><Print src={studio} alt="A dark spin studio lit teal, full of riders on bikes." tilt={-1.5} tape="pink" tag="Spin" sizes="(min-width: 900px) 30vw, 86vw" /></li>
          <li><Print src={yoga} alt="Women in a yoga class raising their arms overhead in blue light." tilt={1.5} tape="teal" tag="Yoga" sizes="(min-width: 900px) 30vw, 86vw" /></li>
          <li><Print src={spin} alt="Three riders smiling together on spin bikes in a teal-lit studio." tilt={-1} tape="pink" tag="Teammates" sizes="(min-width: 900px) 30vw, 86vw" /></li>
          <li><Print src={raffle} alt="Two women holding up a raffle basket at a vendor table." tilt={1} tape="teal" tag="Raffles" sizes="(min-width: 900px) 30vw, 86vw" /></li>
          <li><Print src={poke} alt="Poke bowls on a wooden board branded Island Fin Poke." tilt={-1.5} tape="pink" tag="Lunch by Island Fin Poke" sizes="(min-width: 900px) 30vw, 86vw" /></li>
          <li><Print src={bags} alt="Two women holding teal OCRA tote bags outside the studio." tilt={1.5} tape="teal" tag="OCRA swag" sizes="(min-width: 900px) 30vw, 86vw" /></li>
        </ul>
        <p class="note">Ovarian Fitness Orlando is run by the Ovarian Cancer Research Alliance. Registration and donations happen on OCRA’s site.</p>
        <div class="next-step">
          <a class="btn" href="/join">Join a meetup</a>
          <a class="link-arrow" href="/events">All events <Arrow /></a>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .head { padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem); }
  .inner { display: grid; gap: 2.5rem; align-items: center; }
  .inner :global(.print) { aspect-ratio: 5 / 4; max-width: 34rem; }
  .crumb a { font-weight: 700; text-decoration-color: var(--pink-strong); }
  h1 { margin-top: 1rem; }
  .when { margin-top: 1rem; font-weight: 700; color: var(--teal-ink); }
  .past-note { margin-top: 1rem; display: inline-block; background: var(--paper); padding: 0.5rem 0.9rem; border-radius: 10px; font-weight: 600; }
  .lede { margin-top: 1rem; max-width: 36rem; }
  @media (min-width: 1000px) { .inner { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; } }
  .gallery { list-style: none; padding: 0; margin-top: 2.5rem; display: grid; gap: 3rem 2.5rem; }
  .gallery :global(.print) { aspect-ratio: 4 / 3; }
  @media (min-width: 700px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .gallery { grid-template-columns: repeat(3, 1fr); } }
  .note { margin-top: 3rem; max-width: 40rem; }
</style>

---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { getEvents } from '../../lib/events';
import { site } from '../../data/site';
const { upcoming, past } = await getEvents();
---
<Base title="Events">
  <section class="section events">
    <div class="wrap">
      <div class="head center" data-fade>
        <h1 class="h-xl events-title">Events</h1>
        <p class="text-lg">Join us for our upcoming community support events.</p>
      </div>

      <ul class="grid" data-upcoming>
        {upcoming.map((e, i) => <EventCard event={e} delay={i * 100} />)}
      </ul>
      <p class="soon center" data-soon hidden={upcoming.length > 0}>
        New events are coming soon. Follow us on <a href={site.instagram} rel="noopener">Instagram</a> for updates.
      </p>

      <div class="past" data-past-section hidden={past.length === 0}>
        <h2 class="h-sm past-title">Past Events</h2>
        <ul class="grid" data-past>
          {past.map((e, i) => <EventCard event={e} delay={i * 100} />)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  // Re-check dates against the visitor's clock, so an event that ended since the last deploy moves to Past Events.
  const up = document.querySelector('[data-upcoming]');
  const past = document.querySelector('[data-past]');
  if (up && past) {
    up.querySelectorAll<HTMLElement>('[data-event-end]').forEach((li) => { if (Number(li.dataset.eventEnd) < Date.now()) past.prepend(li); });
    if (!up.children.length) document.querySelector<HTMLElement>('[data-soon]')!.hidden = false;
    if (past.children.length) document.querySelector<HTMLElement>('[data-past-section]')!.hidden = false;
  }
</script>

<style>
  .events { background: rgb(235 186 217 / 0.24); padding-top: 80px; }
  .events-title { font-size: 90px; line-height: 90px; }
  .head .text-lg { margin-top: 20px; }
  .grid { list-style: none; padding: 0; margin-top: 60px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; align-items: stretch; }
  .grid:empty { display: none; }
  .soon { margin-top: 40px; font-size: var(--text); }
  .past { margin-top: 80px; }
  .past-title { text-align: center; }
  .past .grid { margin-top: 40px; }
  [hidden] { display: none !important; }
  @media (max-width: 1024px) { .grid { grid-template-columns: 1fr 1fr; } .events-title { font-size: 70px; line-height: 80px; } }
  @media (max-width: 767px) { .events { padding: 60px 20px 40px; } .grid { grid-template-columns: 1fr; gap: 30px; margin-top: 40px; } .events-title { font-size: 50px; line-height: 50px; } .past { margin-top: 50px; } }
</style>
